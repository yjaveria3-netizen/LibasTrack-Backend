PORT=5000
NODE_ENV=production
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/libastrack?retryWrites=true&w=majority

JWT_SECRET=<paste-a-long-random-string-here>
ENCRYPTION_SECRET=<paste-another-long-random-string-here>

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

GOOGLE_REDIRECT_URI=https://your-backend.railway.app/api/auth/google/callback
FRONTEND_URL=https://libastrack.com