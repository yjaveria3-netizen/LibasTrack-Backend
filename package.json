{
  "name": "libastrack-backend",
  "version": "1.0.0",
  "description": "Backend for LibasTrack - Fashion brand management system",
  "main": "server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "diagnose": "node diagnose.js",
    "test-syntax": "node test-syntax.js",
    "postinstall": "node -e \"const fs=require('fs'); const path=require('path'); const p=path.join(process.cwd(),'node_modules','readable-stream','passthrough.js'); if(!fs.existsSync(p)){ fs.writeFileSync(p, 'module.exports = require(\\'./lib/_stream_passthrough\\');\\n'); }\""
  },
  "packageManager": "npm@9.8.0",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.0.0",
    "googleapis": "^126.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "readable-stream": "3.6.2",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "readable-stream": "3.6.2",
    "lazystream": "1.0.1",
    "archiver-utils": "2.1.0"
  }
}
